{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/session_start.sh",
            "timeout": 20,
            "statusMessage": "Carico il briefing di studio..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/session_end.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
